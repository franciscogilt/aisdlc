{
  "protected": [
    ".github/workflows/",
    "/migrations/",
    "Dockerfile",
    "docker-compose",
    "infra/",
    "terraform/"
  ],
  "secrets": [
    ".env"
  ],
  "dependencies": [
    "requirements.txt",
    "pyproject.toml",
    "Pipfile"
  ],
  "install_patterns": [
    "\\bpip3?\\s+install\\s+\\S",
    "\\bpoetry\\s+add\\b",
    "\\buv\\s+(add|pip\\s+install)\\b",
    "\\bpipenv\\s+install\\s+\\S"
  ]
}
